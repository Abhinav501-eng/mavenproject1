pipeline{
    agent any
    stages{
        stage('SCM checkout'){
            steps{git branch: 'master', url: 'https://github.com/Abhinav501-eng/mavenproject1.git'}
        }
        stage('code compilation'){
            steps{'withMaven(globalMavenSettingsConfig: '', jdk: 'JAVA ', maven: 'MAVEN', mavenSettingsConfig: '', traceability: true) {
        sh 'mvn compile'
}'}
        }
    }
}